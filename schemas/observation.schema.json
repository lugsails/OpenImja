{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenImja derived observation",
  "type": "object",
  "required": ["lake_id", "variable", "value", "unit", "observed_at", "processed_at", "source", "method", "method_version", "confidence", "quality_flags", "freshness", "provenance", "observation_state", "rejection_reasons"],
  "properties": {
    "lake_id": {"type": "string"},
    "variable": {"const": "lake_area"},
    "value": {"type": ["number", "null"], "minimum": 0},
    "unit": {"const": "km2"},
    "observed_at": {"type": "string", "format": "date-time"},
    "processed_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string"},
    "source_product": {"type": "string"},
    "source_url": {"type": ["string", "null"], "format": "uri"},
    "method": {"type": "string"},
    "method_version": {"type": "string"},
    "parameters": {"type": "object"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "publication_status": {"enum": ["candidate", "published"]},
    "observation_state": {"enum": ["discovered", "processed", "rejected", "reviewed", "published"]},
    "rejection_reasons": {"type": "array", "items": {"type": "string"}},
    "state_history": {"type": "array", "items": {"type": "object", "required": ["state", "at"]}},
    "qa": {"type": "object", "properties": {"aoi_valid_fraction": {"type": ["number", "null"]}, "lake_envelope_valid_fraction": {"type": ["number", "null"]}, "reference_lake_envelope_path": {"type": ["string", "null"]}, "outlier_reference_observation": {"type": ["string", "null"]}, "relative_area_change": {"type": ["number", "null"]}}},
    "freshness": {"type": "object", "required": ["status", "age_days", "evaluated_at"]},
    "boundary_geojson_url": {"type": ["string", "null"]},
    "provenance": {"type": "object", "required": ["code_version", "config_path", "image_id"]}
  },
  "additionalProperties": false
}
